rules_version = '2';
/*
 * RJ Inventory & Sales — Firestore Security Rules.
 * These rules are the real security boundary (KI-002): the app's code is visible to anyone with the folder.
 * Scope: Phase 2 (owner bootstrap, users, usernames, settings), Phase 4 (items, inventoryMovements, stockCounts,
 * activityLogs), Phase 5 (customers), Phases 6–7 (counters, sales, installments, payments), Phase 8 (suppliers, restocks,
 * expenses), Phase 9 (calendarEvents), Phase 11 (opening balances, backup restore) and Phase 13 (batches, supplier codes,
 * sale charges).
 * Every other path is denied until its phase adds rules.
 * Cross-document consistency (item quantity == sum of its movements) is enforced by client transactions (KI-003, D-016);
 * these rules enforce per-document shape and invariants.
 * Tests: tests/rules/firestore.rules.test.js (Firestore emulator) — `npm run test:rules`.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function bootstrapPath() { return /databases/$(database)/documents/settings/bootstrap; }
    function isActive() { return signedIn() && exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.active == true; }
    function isOwner() { return isActive() && get(userPath(request.auth.uid)).data.role == 'owner'; }

    // True only inside the one-time setup batch: no owner exists yet, and the same batch names this user as owner.
    function isBootstrapping() {
      return signedIn()
        && !exists(bootstrapPath())
        && existsAfter(bootstrapPath())
        && getAfter(bootstrapPath()).data.ownerUid == request.auth.uid;
    }

    // ---- Settings ------------------------------------------------------------------------------------------
    match /settings/bootstrap {
      allow get: if true;                    // login screen checks whether first-time setup is needed
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && existsAfter(userPath(request.auth.uid));
      allow update, delete: if false;        // the owner can never be replaced from the app
    }
    match /settings/{doc} {
      allow read: if isActive();
      allow create, update: if isOwner() && doc != 'bootstrap';
      allow delete: if false;
    }

    // ---- Users -------------------------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if isBootstrapping()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'role', 'active', 'preferences', 'createdAt'])
        && request.resource.data.role == 'owner'
        && request.resource.data.active == true;
      // Users may change only their own appearance preferences. Role/active changes come with staff accounts (DF-004).
      allow update: if isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferences']);
      allow delete: if false;
    }

    // ---- Usernames (pre-login lookup → recovery email; D-011, D-015) ------------------------------------
    match /usernames/{name} {
      allow get: if true;                    // exact-name lookup only
      allow list: if false;                  // never enumerable
      allow create: if isBootstrapping()
        && name.matches('^[a-z0-9._-]{3,32}$')
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ---- Phase 4: inventory ---------------------------------------------------------------------------------
    function isInt(v) { return v is int; }
    function nonNegInt(v) { return v is int && v >= 0; }
    function optString(v) { return v == null || v is string; }

    function validItem(d) {
      return d.keys().hasAll(['name', 'nameLower', 'unit', 'qtyH', 'priceC', 'costC', 'minStockH', 'status'])
        && d.keys().hasOnly(['name', 'nameLower', 'variety', 'category', 'unit', 'sackWeightKg', 'linkedSackItemId', 'linkedKgItemId',
             'sku', 'description', 'qtyH', 'priceC', 'installmentPriceC', 'costC', 'minStockH', 'supplierId', 'status', 'batches', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.nameLower == d.name.lower()
        && d.unit in ['SACK', 'KG']
        && nonNegInt(d.qtyH) && nonNegInt(d.priceC) && nonNegInt(d.costC) && nonNegInt(d.minStockH)
        && (!('installmentPriceC' in d) || d.installmentPriceC == null || nonNegInt(d.installmentPriceC))
        // Phase 13 (D-050): open stock batches, oldest first, kept on the item (Σ batches ≤ qtyH is kept by the client).
        && (!('batches' in d) || d.batches == null || (d.batches is list && d.batches.size() <= 150))
        && (d.unit == 'KG' || (d.qtyH % 100 == 0 && d.sackWeightKg is number && d.sackWeightKg > 0))
        && d.status in ['ACTIVE', 'ARCHIVED'];
    }
    match /items/{id} {
      allow read: if isActive();
      allow create: if isOwner() && validItem(request.resource.data);
      allow update: if isOwner() && validItem(request.resource.data) && request.resource.data.unit == resource.data.unit;
      allow delete: if false;                // BR-018: items are archived, never deleted
    }

    match /inventoryMovements/{id} {
      allow read: if isActive();
      allow create: if isOwner()
        && request.resource.data.type in ['OPENING', 'SALE', 'SALE_CANCEL', 'RESTOCK_RECEIPT', 'ADJUSTMENT', 'COUNT_ADJUSTMENT', 'SACK_OPEN_OUT', 'SACK_OPEN_IN']
        && request.resource.data.itemId is string
        && request.resource.data.unit in ['SACK', 'KG']
        && isInt(request.resource.data.qtyDeltaH) && request.resource.data.qtyDeltaH != 0
        && nonNegInt(request.resource.data.qtyBeforeH) && nonNegInt(request.resource.data.qtyAfterH)
        && request.resource.data.qtyAfterH == request.resource.data.qtyBeforeH + request.resource.data.qtyDeltaH
        && nonNegInt(request.resource.data.unitCostC)
        && request.resource.data.businessDate is string
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.type != 'ADJUSTMENT' || (request.resource.data.reason is string && request.resource.data.reason.size() > 0));
      allow update, delete: if false;        // BR-011: movements are immutable
    }

    match /stockCounts/{id} {
      allow read: if isActive();
      allow create: if isOwner() && request.resource.data.status == 'DRAFT' && request.resource.data.lines is list;
      allow update: if isOwner() && resource.data.status == 'DRAFT'
        && request.resource.data.status in ['DRAFT', 'FINALIZED'] && request.resource.data.lines is list;
      allow delete: if isOwner() && resource.data.status == 'DRAFT';   // finalized counts are read-only (BR-017)
    }

    // ---- Phase 5: customers ----------------------------------------------------------------------------------
    // Alternate contacts are embedded (BR-022). Summary fields are kept by the sale/payment services (BR-023).
    function validCustomer(d) {
      return d.keys().hasAll(['name', 'nameLower', 'type', 'status', 'outstandingC', 'totalPurchasesC', 'alternateContacts'])
        && d.keys().hasOnly(['name', 'nameLower', 'type', 'system', 'address', 'contactNumber', 'email', 'facebook', 'notes', 'creditLimitC',
             'alternateContacts', 'outstandingC', 'totalPurchasesC', 'lastSaleDate', 'paidInstallments', 'paidOnTime', 'status',
             'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.nameLower == d.name.lower()
        && d.type in ['Household', 'Store', 'Reseller', 'Carinderia', 'Other']
        && d.status in ['ACTIVE', 'ARCHIVED']
        && (d.creditLimitC == null || nonNegInt(d.creditLimitC))
        && nonNegInt(d.outstandingC) && nonNegInt(d.totalPurchasesC)
        && (!('paidInstallments' in d) || nonNegInt(d.paidInstallments))
        && (!('paidOnTime' in d) || nonNegInt(d.paidOnTime))
        && d.alternateContacts is list && d.alternateContacts.size() <= 20;
    }
    match /customers/{id} {
      allow read: if isActive();
      // The built-in Walk-in customer (BR-020) is created once with a fixed identity and can never be archived.
      allow create: if isOwner() && validCustomer(request.resource.data)
        && (id == 'WALK_IN') == (request.resource.data.get('system', false) == true)
        && (id != 'WALK_IN' || (request.resource.data.name == 'Walk-in' && request.resource.data.status == 'ACTIVE'));
      allow update: if isOwner() && validCustomer(request.resource.data)
        && request.resource.data.get('system', false) == resource.data.get('system', false)
        && (id != 'WALK_IN' || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['outstandingC', 'totalPurchasesC', 'lastSaleDate', 'paidInstallments', 'paidOnTime', 'updatedAt', 'updatedBy']))
        // BR-026: cannot archive while a balance is outstanding
        && (request.resource.data.status == 'ACTIVE' || request.resource.data.outstandingC == 0);
      allow delete: if false;
    }

    // ---- Phases 6–7: counters, sales, installments (receivable rows), payments -----------------------------
    // Cross-document consistency (sale totals vs rows vs payments vs stock) is kept by client transactions (KI-003);
    // these rules keep each document's own arithmetic and lifecycle honest.
    function isMethod(m) { return m in ['CASH', 'BANK', 'EWALLET']; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDate(v) { return v == null || isDate(v); }

    // Sequence counters (BR-030, BR-050): sale-YYYY and payment-YYYY; each write takes exactly the next number.
    // Phase 13 (D-051): `supplier` (supplier codes) and batch-<code> (batch ids) may advance by several at once
    // (codes for many old suppliers, first batches for many old items), never backwards.
    function isBatchCounter(name) { return name == 'supplier' || name.matches('^batch-(SUP[0-9]{3,}|OLD)$'); }
    match /counters/{name} {
      allow read: if isActive();
      allow create: if isOwner() && (name.matches('^(sale|payment|restock|ob)-[0-9]{4}$') || isBatchCounter(name))
        && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next is int && request.resource.data.next >= 2;
      allow update: if isOwner() && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next is int
        && (request.resource.data.next == resource.data.next + 1 || (isBatchCounter(name) && request.resource.data.next > resource.data.next));
      allow delete: if false;
    }

    // D-054: other charges (delivery fee …) are added after the discount; older sales have no chargesC.
    function validSaleMoney(d) {
      return nonNegInt(d.subtotalC) && nonNegInt(d.discountC) && nonNegInt(d.totalC) && nonNegInt(d.paidC) && nonNegInt(d.balanceC)
        && nonNegInt(d.get('chargesC', 0))
        && (!('charges' in d) || (d.charges is list && d.charges.size() <= 10))
        && d.discountC <= d.subtotalC && d.totalC == d.subtotalC - d.discountC + d.get('chargesC', 0);
    }
    match /sales/{id} {
      allow read: if isActive();
      // Phase 11 (BR-081, D-045): opening balances carried over from Excel — no lines, nothing paid, no revenue.
      allow create: if isOwner()
        && request.resource.data.saleNo == id
        && id.matches('^OB-[0-9]{4}-[0-9]{5}$')
        && request.resource.data.kind == 'OPENING_BALANCE'
        && request.resource.data.status == 'ACTIVE'
        && isDate(request.resource.data.saleDate)
        && request.resource.data.customerId is string && request.resource.data.customerId != 'WALK_IN'
        && request.resource.data.lines is list && request.resource.data.lines.size() == 0
        && validSaleMoney(request.resource.data) && request.resource.data.discountC == 0
        && request.resource.data.totalC > 0 && request.resource.data.paidC == 0 && request.resource.data.balanceC == request.resource.data.totalC
        && request.resource.data.terms in ['OPEN_BALANCE', 'INSTALLMENT']
        && request.resource.data.paymentIds is list && request.resource.data.paymentIds.size() == 0
        && request.resource.data.installmentCount is int && request.resource.data.installmentCount >= 1 && request.resource.data.installmentCount <= 5
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.createdBy == request.auth.uid;
      allow create: if isOwner()
        && request.resource.data.saleNo == id
        && id.matches('^[A-Z0-9]{1,6}-?[0-9]{4}-[0-9]{5}$')
        && request.resource.data.kind == 'SALE'
        && request.resource.data.status == 'ACTIVE'
        && isDate(request.resource.data.saleDate)
        && request.resource.data.customerId is string
        && request.resource.data.lines is list && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 40
        && validSaleMoney(request.resource.data)
        && request.resource.data.paidC + request.resource.data.balanceC == request.resource.data.totalC
        && request.resource.data.terms in ['FULL', 'OPEN_BALANCE', 'INSTALLMENT']
        && (request.resource.data.terms != 'FULL' || request.resource.data.balanceC == 0)
        // BR-021: Walk-in sales are paid in full
        && (request.resource.data.customerId != 'WALK_IN' || request.resource.data.balanceC == 0)
        && request.resource.data.fulfillment in ['PENDING', 'DELIVERED', 'PICKED_UP']
        && request.resource.data.createdBy == request.auth.uid;
      // BR-035: saved sales are locked; only payments, delivery, notes and cancellation change them. Cancelled = final.
      allow update: if isOwner() && resource.data.status == 'ACTIVE'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidC', 'balanceC', 'paymentStatus', 'paymentIds',
             'fulfillment', 'deliveryDate', 'notes', 'status', 'cancel', 'updatedAt', 'updatedBy'])
        && nonNegInt(request.resource.data.paidC) && nonNegInt(request.resource.data.balanceC)
        && request.resource.data.fulfillment in ['PENDING', 'DELIVERED', 'PICKED_UP']
        && optDate(request.resource.data.deliveryDate)
        && (
          (request.resource.data.status == 'ACTIVE'
            && request.resource.data.paidC + request.resource.data.balanceC == resource.data.totalC)
          || (request.resource.data.status == 'CANCELLED'
            && request.resource.data.paidC == 0 && request.resource.data.balanceC == 0
            && request.resource.data.cancel.reason is string && request.resource.data.cancel.reason.size() > 0)
        );
      allow delete: if false;
    }

    function rowStatusOk(d) {
      return d.status == 'CANCELLED'
        || (d.status == 'PAID' && d.paidC == d.amountC)
        || (d.status == 'PARTIAL' && d.paidC > 0 && d.paidC < d.amountC)
        || (d.status == 'PENDING' && d.paidC == 0);
    }
    match /installments/{id} {
      allow read: if isActive();
      allow create: if isOwner()
        && request.resource.data.saleId is string
        && id == request.resource.data.saleId + '-' + string(request.resource.data.no)
        && request.resource.data.kind in ['INSTALLMENT', 'OPEN_BALANCE']
        && request.resource.data.no is int && request.resource.data.no >= 1 && request.resource.data.no <= 5
        && request.resource.data.amountC is int && request.resource.data.amountC > 0
        && request.resource.data.paidC == 0 && request.resource.data.status == 'PENDING'
        && optDate(request.resource.data.dueDate)
        && request.resource.data.revisions is list && request.resource.data.revisions.size() == 0;
      // Payments, voids, reschedules (BR-045: revisions only grow) and cancellation. Cancelled rows are final.
      allow update: if isOwner() && resource.data.status != 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountC', 'dueDate', 'paidC', 'status', 'paidDate', 'revisions', 'updatedAt', 'updatedBy'])
        && request.resource.data.amountC is int && request.resource.data.amountC > 0
        && nonNegInt(request.resource.data.paidC) && request.resource.data.paidC <= request.resource.data.amountC
        && rowStatusOk(request.resource.data)
        && optDate(request.resource.data.dueDate)
        && request.resource.data.revisions is list && request.resource.data.revisions.size() >= resource.data.revisions.size();
      allow delete: if false;
    }

    // BR-052: payments are never edited or deleted; the only change is ACTIVE → VOIDED with a reason.
    match /payments/{id} {
      allow read: if isActive();
      allow create: if isOwner()
        && id.matches('^PAY-[0-9]{4}-[0-9]{5}$')
        && request.resource.data.saleId is string && request.resource.data.customerId is string
        && isDate(request.resource.data.date)
        && request.resource.data.amountC is int && request.resource.data.amountC > 0
        && isMethod(request.resource.data.method)
        && request.resource.data.allocations is list
        && request.resource.data.status == 'ACTIVE' && request.resource.data.void == null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner() && resource.data.status == 'ACTIVE'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'void'])
        && request.resource.data.status == 'VOIDED'
        && request.resource.data.void.reason is string && request.resource.data.void.reason.size() > 0;
      allow delete: if false;
    }

    // ---- Phase 8: suppliers, restocks, expenses ------------------------------------------------------------
    function validSupplier(d) {
      return d.keys().hasAll(['name', 'nameLower', 'status'])
        && d.keys().hasOnly(['name', 'nameLower', 'code', 'contactPerson', 'contactNumber', 'email', 'address', 'notes', 'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && (!('code' in d) || (d.code is string && d.code.matches('^SUP[0-9]{3,}$')))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120 && d.nameLower == d.name.lower()
        && d.status in ['ACTIVE', 'ARCHIVED'];
    }
    match /suppliers/{id} {
      allow read: if isActive();
      allow create: if isOwner() && validSupplier(request.resource.data);
      allow update: if isOwner() && validSupplier(request.resource.data);
      allow delete: if false;                // suppliers keep their restock history
    }

    // BR-060: ORDERED → PARTIALLY_RECEIVED → RECEIVED, or CANCELLED only while nothing was received. Receipts only grow.
    function validRestock(d) {
      return d.keys().hasOnly(['restockNo', 'supplierId', 'supplierName', 'orderDate', 'expectedDate', 'status', 'lines', 'receipts', 'totalCostC',
             'notes', 'cancel', 'closed', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.supplierId is string && isDate(d.orderDate) && optDate(d.expectedDate)
        && d.status in ['ORDERED', 'PARTIALLY_RECEIVED', 'RECEIVED', 'CANCELLED']
        && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 40
        && d.receipts is list && nonNegInt(d.totalCostC);
    }
    match /restocks/{id} {
      allow read: if isActive();
      allow create: if isOwner() && validRestock(request.resource.data)
        && id.matches('^RS-[0-9]{4}-[0-9]{5}$') && request.resource.data.restockNo == id
        && request.resource.data.status == 'ORDERED' && request.resource.data.receipts.size() == 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner() && validRestock(request.resource.data)
        && resource.data.status in ['ORDERED', 'PARTIALLY_RECEIVED']               // received and cancelled orders are final
        && request.resource.data.restockNo == resource.data.restockNo
        && request.resource.data.receipts.size() >= resource.data.receipts.size()
        && (request.resource.data.status != 'CANCELLED'
            || (resource.data.status == 'ORDERED' && resource.data.receipts.size() == 0
                && request.resource.data.receipts.size() == 0
                && request.resource.data.cancel.reason is string && request.resource.data.cancel.reason.size() > 0))
        && (request.resource.data.status != 'ORDERED' || request.resource.data.receipts.size() == 0);
      allow delete: if false;
    }

    // BR-063: expenses are corrected by voiding, never edited or deleted.
    match /expenses/{id} {
      allow read: if isActive();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['date', 'category', 'amountC', 'note', 'status', 'void', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && isDate(request.resource.data.date)
        && request.resource.data.category in ['Delivery/Fuel', 'Rent', 'Wages', 'Utilities', 'Supplies', 'Other']
        && request.resource.data.amountC is int && request.resource.data.amountC > 0
        && optString(request.resource.data.note)
        && request.resource.data.status == 'ACTIVE' && request.resource.data.void == null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner() && resource.data.status == 'ACTIVE'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'void', 'updatedAt', 'updatedBy'])
        && request.resource.data.status == 'VOIDED'
        && request.resource.data.void.reason is string && request.resource.data.void.reason.size() > 0;
      allow delete: if false;
    }

    // ---- Phase 9: custom calendar events (reminders; may be edited and deleted) ----------------------------
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'date', 'time', 'note', 'category', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && isDate(d.date)
        && (d.time == '' || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && optString(d.note) && d.category == 'OTHER';
    }
    match /calendarEvents/{id} {
      allow read: if isActive();
      allow create, update: if isOwner() && validEvent(request.resource.data);
      allow delete: if isOwner();
    }

    // ---- Activity log (BR-093): append-only ---------------------------------------------------------------
    match /activityLogs/{id} {
      allow read: if isOwner();
      allow create: if isActive() && request.resource.data.by == request.auth.uid
        && request.resource.data.action is string && request.resource.data.summary is string;
      allow update, delete: if false;
    }

    // ---- Phase 11: restore a backup (RQ-042, BR-094, D-044) --------------------------------------------------
    // A restore makes the database equal to a backup file, so it must write documents (paid installments, used
    // counters, old activity entries) that the normal lifecycle rules above would refuse. The owner opens the window
    // by setting settings/restore.active = true (allowed by the settings rule above, owner only); while it is open
    // the owner may write and delete business collections. Sign-in data (users, usernames) and settings/bootstrap
    // are never reachable this way. The app closes the window when the restore finishes (and logs it).
    function restoring() {
      return isOwner()
        && exists(/databases/$(database)/documents/settings/restore)
        && get(/databases/$(database)/documents/settings/restore).data.active == true;
    }
    match /{col}/{id} {
      allow create, update, delete: if col in ['counters', 'items', 'inventoryMovements', 'stockCounts', 'customers', 'sales',
          'installments', 'payments', 'suppliers', 'restocks', 'expenses', 'calendarEvents', 'activityLogs']
        && restoring();
    }
    match /settings/{doc} {
      allow delete: if doc != 'bootstrap' && doc != 'restore' && restoring();
    }

    // ---- Everything else: denied until the module's phase adds rules ------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
